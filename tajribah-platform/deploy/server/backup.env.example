# T108 — /etc/tajribah/backup.env on the database server (owner root, mode 600). Read by
# tajribah-backup.service. The R2 values come from ~/.tajribah/backup.env on Nader's computer.
#
# The read-only backup login (once, as postgres):
#   CREATE ROLE tajribah_backup LOGIN BYPASSRLS PASSWORD '…';
#   GRANT pg_read_all_data TO tajribah_backup;
# pg_read_all_data covers every table, including the monthly partitions created later; the admin login
# cannot dump those (pg_dump locks each partition, and it has no grant on them).
BACKUP_DB_URL=postgresql://tajribah_backup:CHANGE_ME@127.0.0.1:5432/tajribah
# Sunday's restore check recreates owners and switches roles, so it needs the superuser.
BACKUP_VERIFY_SERVER=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres
BACKUP_R2_ACCOUNT_ID=bd0491e496ffa057396c434b050520a1
BACKUP_R2_BUCKET=tajribah-backups
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
