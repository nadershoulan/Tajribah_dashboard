# Tajribah platform — environment template.
#
# GENERATED from server/core/config/env.ts by `node scripts/gen-env-example.mjs`.
# Do not edit by hand: change the registry and regenerate. A test fails when they differ.
#
# [required]  boot fails without it.
# [secret]    never commit a real value; set it in the secret store for each environment.
# Conditional requirements (e.g. RESEND_API_KEY when EMAIL_PROVIDER=resend) are in the notes.

# ── runtime ─────────────────────────────────────────────────────────────────────

# Runtime mode. (default: development)
NODE_ENV=development

# [required] Public origin of the dashboard. Used for links in email and the ?next= allow-list.
APP_URL=http://localhost:5173

# [required] [secret] HMAC key for access tokens. 32+ bytes of randomness. Rotating it logs everyone out.
AUTH_SECRET=generate-with-openssl-rand-base64-48

# [required] [secret] AES-256-GCM key for store connection tokens at rest (§7.5). Domain-separated from AUTH_SECRET.
ENCRYPTION_KEY=generate-with-openssl-rand-base64-48

# [secret] Only while rotating ENCRYPTION_KEY: the old key, so tokens it sealed still open. The worker re-seals them; remove it once none are left.
ENCRYPTION_KEY_PREVIOUS=

# Access token lifetime. The refresh token outlives it and rotates. (default: 15)
SESSION_TTL_MINUTES=15

# Refresh token lifetime. (default: 30)
REFRESH_TTL_DAYS=30

# console prints to the log in development; resend needs RESEND_API_KEY. (default: console)
EMAIL_PROVIDER=console

# [secret] Required when EMAIL_PROVIDER=resend.
RESEND_API_KEY=

# Sender address, on a domain verified in Resend. Required when EMAIL_PROVIDER=resend.
EMAIL_FROM="Tajribah <no-reply@example.com>"

# Phone OTP transport. Production must not be console. (default: console)
SMS_PROVIDER=console

# [secret] Required when SMS_PROVIDER=unifonic.
UNIFONIC_APP_SID=

# Registered alphanumeric sender name (CST-approved, max 11). Required when SMS_PROVIDER=unifonic.
UNIFONIC_SENDER_ID=

# Salla partner app. Blocks the P1 core loop until the partner account exists (§12.1).
SALLA_CLIENT_ID=

# [secret] Salla partner app secret.
SALLA_CLIENT_SECRET=

# [secret] Verifies webhook signatures against the raw body (§13.6).
SALLA_WEBHOOK_SECRET=

# Public base for R2 assets. Models and textures are served from here, never from the app.
CDN_BASE_URL=https://cdn.example.com

# memory keeps files in-process (local only, lost on restart). r2 uses the BUCKET binding and needs CDN_BASE_URL. (default: memory)
STORAGE_PROVIDER=memory

# Cloudflare account id. With the three below it enables presigned direct-to-R2 uploads.
R2_ACCOUNT_ID=

# The bucket the BUCKET binding points at.
R2_BUCKET_NAME=

# [secret] R2 S3 API token id (Object Read & Write, this bucket only).
R2_ACCESS_KEY_ID=

# [secret] R2 S3 API token secret.
R2_SECRET_ACCESS_KEY=

# Where published viewer configs live (P1.15). memory is local only; kv uses the CONFIGS KV binding the config host reads. (default: memory)
CONFIG_STORE=memory

# inline runs jobs in-process (local only). cf-queue needs the Cloudflare account (T6). (default: inline)
JOBS_MODE=inline

# Minimum level written to the structured log. (default: info)
LOG_LEVEL=info
